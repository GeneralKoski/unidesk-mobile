# Unidesk mobile — variabili pubbliche (esposte nel bundle, NON metterci segreti)

# Base REST Esse3 (e3rest). Le chiamate Esse3 avvengono direttamente da device
# (HTTP Basic con le credenziali Unipr). Default: Unipr.
EXPO_PUBLIC_ESSE3_BASE=https://unipr.esse3.cineca.it/e3rest/api

# Backend Unidesk (Next.js) per i corsi Elly: il login SSO Shibboleth e il proxy
# dei materiali girano server-side e non sono replicabili on-device. Punta al
# backend pubblico (HTTPS) così l'app funziona ovunque con la sola connessione del
# telefono. Vuoto = tab Corsi disabilitata ("configura backend").
EXPO_PUBLIC_API_URL=https://unidesk.martin-trajkovski.it

# Log su console (dev). true in sviluppo, false in produzione.
EXPO_PUBLIC_CONSOLE_LOGGING=true
